# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Standalone binds to localhost otherwise, and the reverse proxy cannot reach it.
HOSTNAME=0.0.0.0

# ── Public ─────────────────────────────────────────────────────────────────
# The SEO identity of this deployment: canonicals, og:url, JSON-LD @ids,
# sitemap and robots all derive from it (lib/env.ts). Build-time — pass it as a
# Docker build arg. Moving staging to the brand domain = change this one value.
NEXT_PUBLIC_SITE_URL=https://serverlys.com
# Search-engine indexing. Leave UNSET: indexable only when SITE_URL is
# https://serverlys.com. "true" opts another origin in (e.g. a staging host that
# is temporarily public — its canonicals point at itself, then 301 it to the
# brand domain at cutover). "false" forces noindex everywhere. Build-time.
NEXT_PUBLIC_ALLOW_INDEXING=
# WHMCS origin. Change in ONE place if billing ever moves to a subdomain.
NEXT_PUBLIC_BILLING_ORIGIN=https://serverlys.com/billing

# ── Domain availability provider ───────────────────────────────────────────
# Which source answers /api/domains/check.
#   whmcs  authoritative — knows premium pricing, reservations and what we sell
#   rdap   real registry lookup, no credentials, DEFAULT when WHMCS is unset
#   none   disables search; the API returns 503 and the UI says so plainly
# There is deliberately no mock option: a fabricated "available" would send
# someone to checkout for a name they cannot buy.
DOMAIN_PROVIDER=rdap

# ── How the app learns a visitor's address ──────────────────────────────────
# Every rate limit on the site keys off this, so getting it wrong either
# throttles real visitors or lets one machine look like thousands.
#
# TRUSTED_PROXY_HOPS — how many proxies sit in front. X-Forwarded-For is read
# this many entries FROM THE RIGHT, because each proxy appends what it saw and
# anything the caller injected lands to the left of it. 1 is correct for the
# Easypanel/Traefik deployment. Change it only when a hop is genuinely added.
TRUSTED_PROXY_HOPS=1
#
# TRUSTED_CLIENT_IP_HEADER — set to cf-connecting-ip ONLY once Cloudflare is in
# front AND the origin refuses connections that did not come from Cloudflare's
# ranges. Without that second half the header is just another field a caller
# can set, and this becomes the bypass it was meant to close. Leave unset
# otherwise; X-Forwarded-For above is then used.
TRUSTED_CLIENT_IP_HEADER=

# WHMCS admin API. Setting all three switches the provider to whmcs.
# The credential needs the DomainWhois permission, and this server's IP must be
# on the WHMCS API allow-list.
# WHMCS_API_URL=https://serverlys.com/billing/includes/api.php
# WHMCS_API_IDENTIFIER=
# WHMCS_API_SECRET=

# ── Search engine verification ─────────────────────────────────────────────
# Ownership tokens for Google Search Console and Bing Webmaster Tools. Not
# secrets — they are published in the page <head>. Leave EMPTY on staging, or
# staging will try to verify the production property.
#
# Google:  Search Console → Add property → HTML tag → copy ONLY the content="…"
#          value, not the whole tag.
# Bing:    Webmaster Tools → Add site → Copy and paste meta tag → the
#          msvalidate.01 content value. Bing can also import from Search
#          Console, which skips this entirely.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Analytics ──────────────────────────────────────────────────────────────
# Full guide: docs/SEO-ANALYTICS-SETUP.md. All BUILD-time (Docker build args).
# Each vendor is off while its ID is empty, and NOTHING loads in a visitor's
# browser until they accept "Analytics" in the cookie banner.
#
# Google Tag Manager container (GTM-XXXXXXX). GA4 is configured INSIDE it.
NEXT_PUBLIC_GTM_ID=
# GA4 measurement ID (G-XXXXXXXXXX). With GTM set it is only handed to GTM
# as the dataLayer variable `ga_measurement_id`; without GTM, gtag.js loads
# directly with it. Never both, so nothing is double counted.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity project ID (the code after /tag/ in Clarity's snippet).
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Unset: on only for a production build whose SITE_URL is https://serverlys.com
# (so `next dev` and staging never pollute reports). "true" forces on — e.g. to
# test locally; "false" forces off everywhere.
NEXT_PUBLIC_ANALYTICS_ENABLED=

# ── Sera — AI assistant ────────────────────────────────────────────────────
# The assistant mounted site-wide from the root layout. Without OPENAI_API_KEY
# the widget still renders, but every message answers with the contact-details
# fallback rather than pretending to think. That is deliberate: see lib/sera/ai.ts.
#
# ⚠ SERVER-ONLY. None of the values below carry NEXT_PUBLIC_, and lib/sera/config.ts
# is marked `server-only`, so importing it from a client component fails the BUILD
# rather than shipping a key to the browser.
OPENAI_API_KEY=
# Any model supporting the Responses API with function tools.
# Defaults to gpt-4.1-mini — cheapest that reliably does multi-field extraction
# and tool calling in one turn, which is the whole job.
OPENAI_MODEL=

# Signs the Sera session cookie, which binds a conversation to one browser.
# Absent, a random per-process secret is used — fine for a single instance,
# but every conversation breaks on restart and across replicas. Set it before
# running more than one container. Any long random string.
# Signs the Sera session cookie. Unset falls back to a per-process random
# value, which works on ONE instance and breaks sessions the moment there are
# two. Generate with: openssl rand -base64 48
SERA_SESSION_SECRET=

# ── Where a submitted request goes ─────────────────────────────────────────
# With NEITHER of the two channels below configured, Sera still RECORDS every
# request and issues a reference — but it tells the visitor plainly that it
# could not confirm delivery and gives them the support address instead. It
# never claims the team was notified when nothing was sent.
#
# 1. Webhook (preferred: one n8n workflow can email, open a WHMCS ticket and
#    write to a CRM from the same payload). Takes precedence over Resend when
#    both are set, so a request is never filed twice.
SERA_WEBHOOK_URL=
# Shared secret sent as X-Sera-Secret. Without it the endpoint is an open relay.
SERA_WEBHOOK_SECRET=
#
# 2. Resend. Called over plain fetch — no SDK dependency.
RESEND_API_KEY=
# Must be on a domain verified in the Resend account, or every send is rejected.
SERA_EMAIL_FROM=sera@serverlys.com
# Where notifications land. Defaults to the published support address.
SERA_TEAM_EMAIL=support@serverlys.com

# Append-only JSONL log of every filed request — the backstop if email fails.
# ⚠ Inside the container this is LOST ON REDEPLOY. Mount a volume, or point this
# at a mounted path, before treating it as the system of record.
SERA_REQUEST_LOG=.sera/requests.jsonl
