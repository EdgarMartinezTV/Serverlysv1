{
  "name": "next-js",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate:tokens": "node scripts/validate-tokens.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run validate:tokens && npm run audit:claims && npm run build",
    "audit:crawl": "node scripts/crawl.mjs",
    "audit:cwv": "node scripts/cwv.mjs",
    "audit:seo": "node scripts/seo-audit.mjs",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "test:home": "node scripts/test-home.mjs",
    "test:whois": "node scripts/test-whois.mjs",
    "test:responsive": "node scripts/test-responsive.mjs",
    "test:nav": "node scripts/test-nav.mjs",
    "test:megamenu": "node scripts/test-megamenu.mjs",
    "test:product": "node scripts/test-product.mjs",
    "test:domains": "node scripts/test-domain-search.mjs",
    "test:console": "node scripts/test-console.mjs",
    "test:sera": "node --experimental-strip-types --no-warnings scripts/test-sera.mjs",
    "audit:a11y": "node scripts/a11y.mjs",
    "audit:links": "node scripts/audit-links.mjs",
    "check:reviews": "node scripts/check-reviews.mjs",
    "test:all": "npm run test:home && npm run test:nav && npm run test:megamenu && npm run test:product && npm run test:live && npm run test:domains && npm run test:whois && npm run test:console && npm run test:ai",
    "test:live": "node scripts/test-live-ui.mjs",
    "test:ai": "node scripts/test-ai-discovery.mjs",
    "audit:claims": "node scripts/audit-article-claims.mjs",
    "port:legacy": "node scripts/port-legacy-articles.mjs",
    "audit:browsers": "node scripts/cross-browser.mjs",
    "cover": "node scripts/generate-cover.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "openai": "^7.15.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
