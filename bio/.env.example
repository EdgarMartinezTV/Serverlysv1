# ── Serverlys Bio — environment ─────────────────────────────────────────────
# Required
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/serverlys_bio"
APP_URL="https://bio.serverlys.com"            # public origin of this app (no trailing slash)
AUTH_SECRET=""                                  # 32+ random bytes: openssl rand -base64 48

# Marketing site
MARKETING_URL="https://serverlys.com/bio"       # where bio.serverlys.com/ sends signed-out visitors
MARKETING_ORIGINS="https://serverlys.com https://www.serverlys.com"  # may frame /t/* template previews

# Email (Resend). Unset = emails are LOGGED to the OutboundEmail table instead of sent.
RESEND_API_KEY=""                               # sending-only key on the verified serverlys.com domain
EMAIL_FROM="Serverlys Bio <bio@serverlys.com>"

# Admin bootstrap: these emails become ADMIN on sign-up / login
ADMIN_EMAILS=""

# Storage. Default = local disk at STORAGE_DIR (mount a volume). Set S3_* for any S3-compatible bucket.
STORAGE_DIR="/app/.data/media"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""                                  # e.g. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Optional malware scanning of file uploads (clamd INSTREAM)
CLAMAV_HOST=""
CLAMAV_PORT="3310"

# Optional shared rate limits across replicas
REDIS_URL=""

# Custom domains: what customers point DNS at
CUSTOM_DOMAIN_TARGET="bio.serverlys.com"
CUSTOM_DOMAIN_TARGET_IP="72.61.9.224"
EXTRA_APP_HOSTS=""                              # other hosts that serve the app itself (comma-separated)
CRON_SECRET=""                                  # bearer token for POST /api/cron/domains

# Optional "Continue with your Serverlys account" (OpenID Connect, e.g. WHMCS)
SERVERLYS_OIDC_ISSUER=""
SERVERLYS_OIDC_DISCOVERY_URL=""                 # if the provider's discovery isn't at <issuer>/.well-known/openid-configuration
SERVERLYS_OIDC_CLIENT_ID=""
SERVERLYS_OIDC_CLIENT_SECRET=""
