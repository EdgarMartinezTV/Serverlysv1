// Serverlys Bio — database schema.
//
// Tenancy rule: every row a customer owns hangs off User → BioPage. Every
// query in src/lib/** that reads private data filters by ownerId (or goes
// through requirePageOwner), so isolation never depends on the UI.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  name             String     @default("")
  passwordHash     String?
  emailVerifiedAt  DateTime?
  role             Role       @default(USER)
  status           UserStatus @default(ACTIVE)
  /// Opt-in only. Product/transactional email is not marketing.
  marketingConsent Boolean    @default(false)
  /// Subject from the Serverlys OIDC provider when the account is linked.
  ssoSubject       String?    @unique
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  lastLoginAt      DateTime?

  sessions     Session[]
  tokens       VerificationToken[]
  pages        BioPage[]
  savedStyles  SavedStyle[]
  assets       Asset[]
  auditEntries AuditLog[]          @relation("actor")
}

model Session {
  id         String   @id @default(cuid())
  /// SHA-256 of the cookie value. The raw token is never stored.
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String   @default("")
  ipHash     String   @default("")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

enum PageStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  SUSPENDED
}

model BioPage {
  id             String     @id @default(cuid())
  ownerId        String
  owner          User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Internal label shown in the dashboard ("Bakery", "Personal").
  name           String     @default("Untitled page")
  /// Lowercase. Null until the owner claims one in the publish step.
  username       String?    @unique
  status         PageStatus @default(DRAFT)
  templateId     String?
  /// The working copy. Validated by lib/bio/schema.ts on every write.
  draft          Json
  /// Bumped on each draft save; a stale autosave is rejected, not merged.
  draftVersion   Int        @default(1)
  /// What the public URL serves. Null until first publish.
  published      Json?
  publishedAt    DateTime?
  /// Email the owner when a form on this page collects a lead.
  notifyLeads    Boolean    @default(true)
  suspendedReason String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  versions  PageVersion[]
  events    AnalyticsEvent[]
  leads     Lead[]
  domains   Domain[]
  reports   Report[]
  redirects UsernameRedirect[]
  assets    Asset[]

  @@index([ownerId])
  @@index([status])
}

enum VersionKind {
  PUBLISH
  TEMPLATE_SWITCH
  RESTORE
  MANUAL
}

model PageVersion {
  id        String      @id @default(cuid())
  pageId    String
  page      BioPage     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  kind      VersionKind
  label     String      @default("")
  content   Json
  createdAt DateTime    @default(now())

  @@index([pageId, createdAt])
}

/// An old username keeps redirecting to its page after a rename, and cannot
/// be claimed by anyone else until releasedAt.
model UsernameRedirect {
  username   String   @id
  pageId     String
  page       BioPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  releasedAt DateTime
}

model SavedStyle {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  theme     Json
  createdAt DateTime @default(now())

  @@index([userId])
}

model Template {
  id          String   @id
  name        String
  category    String
  description String   @default("")
  content     Json
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model Asset {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  pageId    String?
  page      BioPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)
  /// Storage key, e.g. "u/<userId>/<assetId>.webp".
  key       String   @unique
  kind      String
  mime      String
  bytes     Int
  width     Int?
  height    Int?
  fileName  String   @default("")
  createdAt DateTime @default(now())

  @@index([ownerId])
}

enum EventType {
  VIEW
  CLICK
}

/// One row per public page view or link click. No raw IP, no cookie: the
/// visitor hash is SHA-256(daily salt + IP + UA), so "unique" means unique
/// per day and cannot be joined across days or back to a person.
model AnalyticsEvent {
  id          BigInt    @id @default(autoincrement())
  pageId      String
  page        BioPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type        EventType
  blockId     String?
  visitorHash String
  referrer    String    @default("")
  source      String    @default("direct")
  device      String    @default("desktop")
  country     String    @default("")
  createdAt   DateTime  @default(now())

  @@index([pageId, createdAt])
  @@index([pageId, type, createdAt])
}

enum LeadKind {
  NEWSLETTER
  CONTACT
}

model Lead {
  id           String    @id @default(cuid())
  pageId       String
  page         BioPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  blockId      String
  kind         LeadKind
  name         String    @default("")
  email        String    @default("")
  phone        String    @default("")
  message      String    @default("")
  consentText  String    @default("")
  consentGiven Boolean   @default(false)
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([pageId, createdAt])
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

model Domain {
  id                String       @id @default(cuid())
  pageId            String
  page              BioPage      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  hostname          String       @unique
  status            DomainStatus @default(PENDING)
  /// Published as TXT _serverlys-bio.<hostname> to prove ownership.
  verificationToken String
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  lastError         String?
  createdAt         DateTime     @default(now())

  @@index([pageId])
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id            String       @id @default(cuid())
  pageId        String
  page          BioPage      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  reason        String
  details       String       @default("")
  reporterEmail String       @default("")
  status        ReportStatus @default(OPEN)
  resolution    String?
  resolvedById  String?
  createdAt     DateTime     @default(now())
  resolvedAt    DateTime?

  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String   @default("")
  targetId   String   @default("")
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

enum EmailStatus {
  SENT
  LOGGED
  FAILED
}

/// Every transactional email, sent or not. With no provider configured the
/// message is LOGGED here instead (local dev + tests read links from it).
model OutboundEmail {
  id         String      @id @default(cuid())
  to         String
  subject    String
  kind       String
  status     EmailStatus
  /// Text body is kept only for LOGGED messages (no provider = dev).
  body       String?
  providerId String?
  error      String?
  createdAt  DateTime    @default(now())

  @@index([to, createdAt])
}
